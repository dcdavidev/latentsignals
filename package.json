    "prettier-plugin-prisma": "^5.0.0",
    "prettier-plugin-properties": "^0.3.1",
    "prettier-plugin-sh": "^0.20.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prettier-plugin-toml": "^4.0.0",
    "typescript": "^5.9.3"
