{
  "name": "latentsignals",
  "private": true,
  "description": "Signals not yet decoded or travelling under the radar accross the network.",
  "keywords": [
    "poetry",
    "signals",
    "network",
    "underground",
    "underground signals",
    "poetry signals",
    "ai poetry",
    "ai signals",
    "ai underground signals",
    "ai underground poetry"
  ],
  "license": "MIT",
  "author": "Davide Di Criscito",
  "type": "module",
  "scripts": {
    "build": "pnpm run website:build",
    "check": "pnpm run go:check && pnpm run py:check && pnpm run rs:check && pnpm run js:check && pnpm run sh:check && pnpm run website:typecheck",
    "commit": "pnpm exec cz",
    "dev": "pnpm run website:dev",
    "fmt": "pnpm run go:fmt && pnpm run py:fmt && pnpm run rs:fmt && pnpm run js:fmt && pnpm run sh:fmt",
    "fmt:check": "pnpm run go:fmt:check && pnpm run py:fmt:check && pnpm run rs:fmt:check && pnpm run js:fmt:check && pnpm run sh:fmt:check",
    "go:check": "task check",
    "go:fmt": "task fmt",
    "go:fmt:check": "task fmt:check",
    "go:lint": "task lint",
    "go:staticcheck": "task staticcheck",
    "go:test": "task test",
    "go:vet": "task vet",
    "js:check": "pnpm run js:lint && pnpm run js:typecheck",
    "js:fmt": "pnpm exec prettier --write .",
    "js:fmt:check": "pnpm exec prettier --check .",
    "js:lint": "pnpm exec eslint .",
    "js:lint:fix": "pnpm exec eslint . --fix",
    "js:lint:format": "pnpm run js:lint:fix && pnpm run js:fmt",
    "js:typecheck": "pnpm run website:typecheck",
    "js:typecheck:fix": "pnpm run website:typecheck:fix",
    "lint": "pnpm run go:lint && pnpm run py:lint && pnpm run rs:lint && pnpm run js:lint && pnpm run sh:lint",
    "lint:fix": "pnpm run py:lint:fix && pnpm run rs:lint:fix && pnpm run js:lint:fix",
    "prepare": "lefthook install",
    "py:check": "uv run poe check",
    "py:fix": "uv run poe fix",
    "py:fmt": "uv run poe fmt",
    "py:fmt:check": "uv run poe fmt-check",
    "py:isort": "uv run poe isort",
    "py:isort:check": "uv run poe isort-check",
    "py:lint": "uv run poe lint",
    "py:lint:fix": "uv run poe lint-fix",
    "py:typecheck": "uv run poe typecheck",
    "rs:check": "cargo check-lib",
    "rs:fmt": "cargo fmt-fix",
    "rs:fmt:check": "cargo fmt-check",
    "rs:lint": "cargo lint",
    "rs:lint:fix": "cargo lint-fix",
    "rs:test": "cargo test-lib",
    "sh:check": "shellcheck ./poetries/**/*.sh",
    "sh:chmod": "chmod +x ./poetries/**/*.sh",
    "sh:fmt": "shfmt -i 2 -sr -w ./poetries/**/*.sh",
    "sh:fmt:check": "shfmt -i 2 -sr -d ./poetries/**/*.sh",
    "sh:lint": "pnpm run sh:check",
    "start": "pnpm run website:start",
    "ts:check": "pnpm run js:check",
    "ts:fmt": "pnpm run js:fmt",
    "ts:fmt:check": "pnpm run js:fmt:check",
    "ts:lint": "pnpm run js:lint",
    "ts:typecheck": "pnpm run js:typecheck",
    "typecheck": "pnpm run js:typecheck",
    "website:build": "pnpm exec react-router build",
    "website:dev": "pnpm exec react-router dev",
    "website:start": "pnpm exec react-router-serve ./build/server/index.js",
    "website:typecheck": "pnpm exec react-router typegen && tsc",
    "website:typecheck:fix": "pnpm exec react-router typegen && tsc --noEmit"
  },
  "config": {
    "commitizen": {
      "path": "cz-git"
    }
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/fira-mono": "^5.3.0",
    "@mui/material": "^9.5.0",
    "@react-router/node": "^8.4.0",
    "@react-router/serve": "^8.4.0",
    "@resvg/resvg-js": "^2.6.2",
    "@vercel/react-router": "^1.3.7",
    "highlight.js": "^11.12.0",
    "isbot": "^5.1.36",
    "marked": "^18.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0",
    "satori": "^0.63.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@prettier/plugin-xml": "^3.4.2",
    "@react-router/dev": "^8.5.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "commitizen": "^4.3.2",
    "commitlint-config-spellbookx": "^0.11.1",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "cz-git": "^1.14.0",
    "eslint": "^9.39.5",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-spellbookx": "^0.11.1",
    "lefthook": "^2.2.2",
    "prettier": "^3.9.10",
    "prettier-config-spellbookx": "^0.11.1",
    "prettier-plugin-astro": "^1.1.1",
    "prettier-plugin-ini": "^1.3.0",
    "prettier-plugin-packagejson": "^3.0.2",
    "prettier-plugin-prisma": "^5.0.0",
    "prettier-plugin-properties": "^0.3.1",
    "prettier-plugin-sh": "^0.20.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prettier-plugin-toml": "^4.0.0",
    "tailwindcss": "^4.2.2",
    "turbo": "^2.11.9",
    "typescript": "^5.9.3",
    "vite": "^8.0.3"
  }
}
