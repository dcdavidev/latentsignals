{
  "name": "latentsignals",
  "version": "1.0.0",
  "private": true,
  "description": "Signals not yet decoded or travelling under the radar accross the network.",
  "keywords": [
    "poetry",
    "signals",
    "network",
    "underground",
    "underground signals",
    "poetry signals",
    "ai poetry",
    "ai signals",
    "ai underground signals",
    "ai underground poetry"
