    "@prettier/plugin-xml": "^3.4.2",
    "@types/node": "^26.6.5",
    "commitizen": "^4.3.2",
    "commitlint-config-spellbookx": "^0.11.1",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "cz-git": "^1.14.0",
    "eslint": "^9.39.5",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-spellbookx": "^0.11.1",
    "prettier": "^3.9.10",
    "prettier-config-spellbookx": "^0.11.1",
    "prettier-plugin-astro": "^1.1.1",
    "prettier-plugin-ini": "^1.3.0",
