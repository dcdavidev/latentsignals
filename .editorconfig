# EditorConfig configuration for the repository
# https://editorconfig.org

root = true

# Top-level defaults across all files
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# TypeScript & JavaScript
[*.{js,jsx,mjs,cjs,ts,tsx,d.ts}]
indent_style = space
indent_size = 2

# Go (Golang) - standard gofmt uses tabs
[*.go]
indent_style = tab
indent_size = 4
tab_width = 4

# Rust - standard rustfmt uses 4 spaces
[*.rs]
indent_style = space
indent_size = 4

# Python - PEP 8 standard uses 4 spaces
[*.py]
indent_style = space
indent_size = 4

# Shell / Bash
[*.{sh,bash,zsh}]
indent_style = space
indent_size = 2

# Data formats (JSON, JSONC, Webmanifest)
[*.{json,jsonc,webmanifest}]
indent_style = space
indent_size = 2

# Configuration formats (YAML, TOML, INI)
[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.toml]
indent_style = space
indent_size = 2

[*.{ini,cfg,conf}]
indent_style = space
indent_size = 2

# Markup & Stylesheets
[*.{html,xml,svg}]
indent_style = space
indent_size = 2

[*.{css,scss,sass,less}]
indent_style = space
indent_size = 2

# Markdown - preserve trailing whitespace for hard line breaks
[*.{md,markdown}]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

# Makefiles - require real tabs
[{Makefile,*.mk}]
indent_style = tab
indent_size = 4
tab_width = 4

# Docker
[{Dockerfile,Dockerfile.*,.dockerignore}]
indent_style = space
indent_size = 2
